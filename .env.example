# ==============================================
# CONFIGURAÇÕES GERAIS DO BOT
# ==============================================

# Token do bot no Telegram (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# IDs numéricos dos administradores (separados por vírgula)
# Esses usuários terão acesso aos comandos administrativos.
ADMIN_TELEGRAM_IDS=123456789,987654321

# Ambiente de execução: development, production, test
NODE_ENV=development

# Nível de log: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Porta onde o servidor Express (webhook) irá rodar
PORT=3000

# URL pública do servidor (necessária para configurar webhooks)
# Exemplo: https://meubot.exemplo.com
PUBLIC_URL=https://meubot.exemplo.com

# Segredo para validar requisições recebidas no webhook (use uma string longa e aleatória)
# Este valor será usado para verificar a autenticidade das chamadas do Mercado Pago.
WEBHOOK_SECRET=SUA_CHAVE_SECRETA_AQUI


# ==============================================
# BANCO DE DADOS (PostgreSQL + Prisma)
# ==============================================

# URL de conexão com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:senha@localhost:5432/telegram_bot_db?schema=public


# ==============================================
# MERCADO PAGO (Pagamentos e Saques)
# ==============================================

# Access Token da aplicação Mercado Pago (produção ou sandbox)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# Webhook URL que o Mercado Pago irá chamar quando houver atualização de pagamento
# Normalmente: PUBLIC_URL + /webhooks/mercadopago
MERCADO_PAGO_WEBHOOK_URL=https://meubot.exemplo.com/webhooks/mercadopago

# Define se o ambiente do Mercado Pago é sandbox (true) ou produção (false)
MERCADO_PAGO_SANDBOX=true


# ==============================================
# SAQUES (Pagamentos para usuários via Pix)
# ==============================================

# O mesmo Access Token do Mercado Pago será usado para saques (se habilitado).
# Caso utilize outro provedor, configure as variáveis abaixo.

# Provedor de saque: mercadopago, outro (futuro)
PAYOUT_PROVIDER=mercadopago

# (Opcional) Access Token específico para payout, se for diferente do de pagamentos
# Caso contrário, o sistema usará MERCADO_PAGO_ACCESS_TOKEN
PAYOUT_ACCESS_TOKEN=


# ==============================================
# OUTRAS INTEGRAÇÕES (futuras, não simuladas)
# ==============================================

# Configurações de e-mail (para notificações futuras)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Configurações de WhatsApp (futuro)
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=


# ==============================================
# OBSERVAÇÕES
# ==============================================
# - Nunca commite este arquivo com valores reais.
# - Use um arquivo .env (gitignored) com os valores corretos.
# - Em produção, defina NODE_ENV=production e use segredos fortes.
